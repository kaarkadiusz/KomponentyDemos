<KAInputText ValidationBehavior="ValidationBehavior.OnValueChange"
             Label="OnChange"
             Validation="new(Validate)"
             ValueEvent="ValueEvent.OnInput"
             @bind-Value="_value" />
<KAInputText ValidationBehavior="ValidationBehavior.OnValueChangeWithDebouncing"
             Label="OnChangeDebounce"
             Validation="new(Validate)"
             ValueEvent="ValueEvent.OnInput"
             @bind-Value="_value" />
<KAInputText ValidationBehavior="ValidationBehavior.Manual"
             Label="Manual"
             @ref="_inputText"
             Validation="new(Validate)"
             ValueEvent="ValueEvent.OnInput"
             @bind-Value="_value" />
<KAButton Text="Validate" OnClick="ValidateManually"/>

@code {
    string _value = string.Empty;
    Task<KAValidationResult?> Validate(string? value)
    {
        if (!string.IsNullOrEmpty(value) && value.Length % 2 == 0)
        {
            KAValidationResult result = new KAValidationResult() { Message = "Value's length is divisible by two", Status = KAValidationStatus.Error };
            return Task.FromResult(result)!;
        }
        return Task.FromResult((KAValidationResult?)null);
    }

    KAInputText? _inputText;
    async Task ValidateManually()
    {
        if(_inputText is not null)
        {
            await _inputText.ValidateAsync();
        }
    }
}
