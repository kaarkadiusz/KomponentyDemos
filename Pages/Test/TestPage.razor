@using Komponenty.Inputs
@using Komponenty.Basic
@using System.ComponentModel.DataAnnotations
@attribute [Route(Metadata.Pages.Test)]

<div style="height: 100%; gap:4px; display: grid; place-content: center; grid-template-columns: clamp(100px, 100%, 200px);">
    <EditForm @ref="editForm" Model="_model">
        <KAInputText @ref="kAInputText1" Validation="new(Validate)" Label="String" @bind-Value="_model.String" />
        <KAInputNumber Label="Integer" @bind-Value="_model.Integer" />

        <p>
            String: @_model.String
        </p>
        <DataAnnotationsValidator />
    </EditForm>
    <KAInputText @ref="kAInputText2"  Label="String" Validation="new(Validate)" @bind-Value="_model.String" />
    <KAInputText Label="String" @bind-Value="_model.String" />
    <KAButton Text="Validate" OnClick="Test" />
</div>

@code {
    private async Task Test()
    {
        Console.WriteLine(editForm?.EditContext?.Validate());
    }

    KAValidationResult? Validate(string? val)
    {
        if (val?.Length > 8)
        {
            return new("Success", KAValidationStatus.Success);
        }
        if(val?.Length > 6)
        {
            return new("Warning", KAValidationStatus.Warning);
        }
        if(val?.Length > 4)
        {
            return new("Błąd");
        }
        return null;
    }

    KAInputText? kAInputText1;
    KAInputText? kAInputText2;
    EditForm? editForm;
    Model _model = new();

    private class Model
    {
        [MaxLength(10)]
        public string String { get; set; } = string.Empty;
        [Range(0, 10)]
        public int Integer { get; set; } = 0;
    }
}
