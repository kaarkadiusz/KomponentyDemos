@using Komponenty.Inputs
@using Komponenty.Basic
@using System.ComponentModel.DataAnnotations
@using Komponenty.Modal
@attribute [Route(Metadata.Pages.Test)]

<div style="height: 100%; gap:4px; display: grid; place-content: center; grid-template-columns: clamp(100px, 100%, 200px);">
    <KAButton Text="Open" OnClick="async () => await (modal1?.OpenAsync() ?? Task.CompletedTask)" />
    <KAButton Text="OpenService" OnClick="OpenModalThroughService" />
    <div style="height: 300px; width: 300px; border: 1px solid red; overflow: auto;">
        <div style="height: 3000px;"></div>
    </div>
</div>

<KAModal @ref="modal1" Title="To jest pierwszy modal">
    <ChildContent>
        <p>Pierwszy modal</p>
        <KAInputText />
        <KAInputNumber T="int" />

        <KAModal @ref="modal2">
            <h3>To jest drugi modal</h3>
            <KAButton Text="Zamknij pierwszy" OnClick="async () => await (modal1?.CloseAsync() ?? Task.CompletedTask)" />
        </KAModal>
    </ChildContent>
    <Actions>
        <KAButton Text="Otwórz drugi" OnClick="async () => await (modal2?.OpenAsync() ?? Task.CompletedTask)" />
    </Actions>
</KAModal>


@code {
    [Inject]
    private KAModalService ModalService { get; set; } = null!;

    KAModal? modal1, modal2;

    private async Task OpenModalThroughService()
    {
        var modalReference = await ModalService.OpenAsync(typeof(TestComponent), new Dictionary<string, object>() { { nameof(TestComponent.Integer), 1 } });
        await Task.Delay(1000);
        await ModalService.OpenAsync(typeof(TestComponent), new Dictionary<string, object>() { { nameof(TestComponent.Integer), int.MaxValue } });
        await Task.Delay(2000);
        if (modalReference is not null)
        {
            await ModalService.CloseAsync(modalReference);
        }
    }
}
