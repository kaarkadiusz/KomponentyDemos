@using Komponenty.Inputs
@using Piaskownica.Components.SimplePage
@using static Piaskownica.Classes.LocalizationBase
@attribute [Route(Metadata.Pages.Inputs.Validation)]

<SimplePage>
    <SimplePageArticle>

        <SimplePageArticleHeading Level="1" Text=@Resources.IntroTitle />
        <SimplePageParagraph>
            @Resources.IntroDescription
        </SimplePageParagraph>
        <Piaskownica.Components.DemoBlock.DemoBlock T="Demos.Inputs.Validation.ValidationBasicDemo" DisplayStyle="Components.DemoBlock.DemoBlockDisplayStyle.GridColumnCenter" />


        <SimplePageArticleHeading Level="2" Text=@Resources.ValidationLogicTitle />
        <SimplePageParagraph>
            @Resources.ValidationParagraph1
        </SimplePageParagraph>
        <SimplePageParagraph>
            @Resources.ValidationParagraph2
        </SimplePageParagraph>

        <SimplePageArticleHeading Level="1" Text=@Resources.ValidationParamTitle />
        <SimplePageParagraph>
            @Resources.ValidationParamDescription
        </SimplePageParagraph>
        <SimplePageParagraph>
            @Resources.ValidationParamDemoPremise
        </SimplePageParagraph>
        <Piaskownica.Components.DemoBlock.DemoBlock T="Demos.Inputs.Validation.ValidationParamDemo" DisplayStyle="Components.DemoBlock.DemoBlockDisplayStyle.GridColumnCenter" />
        <SimplePageArticleHeading Level="2" Text=@Resources.ValidationOutsideFormTitle />
        <SimplePageParagraph>
            @Resources.ValidationOutsideFormDescription
        </SimplePageParagraph>
        <Piaskownica.Components.DemoBlock.DemoBlock T="Demos.Inputs.Validation.ValidationOutsideFormDemo" DisplayStyle="Components.DemoBlock.DemoBlockDisplayStyle.GridColumnCenter" />

        <SimplePageArticleHeading Level="1" Text=@Resources.ValidationBehaviorTitle />
        <SimplePageParagraph>
            @Resources.ValidationBehaviorDescription
        </SimplePageParagraph>
        <SimplePageParagraph>
            @Resources.ValidationBehaviorDemoDescription
        </SimplePageParagraph>
        <Piaskownica.Components.DemoBlock.DemoBlock T="Demos.Inputs.Validation.ValidationValidationBehaviorDemo" DisplayStyle="Components.DemoBlock.DemoBlockDisplayStyle.GridColumnCenter" />

    </SimplePageArticle>
</SimplePage>

@code {
    private static class Resources
    {
        public static string IntroTitle => CurrentLocalization switch
        {
            LocalizationVariant.PL => "Walidacja formularza",
            _ or LocalizationVariant.EN => "Form validation"
        };
        public static RenderFragment IntroDescription => CurrentLocalization switch
        {
        LocalizationVariant.PL => @<span>Zaimplementowana walidacja jest zintegrowana z <span class="component">EditForm</span> Blazora, umożliwiając jednocześnie walidację poza formularzem. </span>,
            _ or LocalizationVariant.EN => @<span>Implemented validation is integrated with Blazor's <span class="component">EditForm</span> while also allowing validating outside form. </span>
            };

            public static string ValidationLogicTitle => CurrentLocalization switch
            {
                LocalizationVariant.PL => "Logika walidacji",
                _ or LocalizationVariant.EN => "Validation logic"
            };
        public static RenderFragment ValidationParagraph1 => CurrentLocalization switch
        {
            LocalizationVariant.PL => @<span>Gdy zostanie zażądana walidacja, przebiega ona w dwóch etapach. Najpierw następuje walidacja względem atrybutów adnotacji danych (jeśli walidacja adnotacji danych jest włączona). Następnie następuje walidacja względem parametru <span class="parameter">@nameof(KAInputBase<>.Validation)</span> (jeśli został ustawiony).</span>,
            _ or LocalizationVariant.EN => @<span>When validation is requested it works in a two steps manner. Firstly it validates against any data annotations attributes (if data annotation validation is enabled). Secondly it validates against <span class="parameter">@nameof(KAInputBase<>.Validation)</span> parameter (if set).</span>
            };

            public static RenderFragment ValidationParagraph2 => CurrentLocalization switch
            {
            LocalizationVariant.PL => @<div>
                <span>Po zakończeniu walidacji pola, jej wyniki zapisywane są w dwóch miejscach:</span>
                <ol>
                    <li>
                        <span class="class">@nameof(ValidationMessageStore)</span> dla tego pola - tutaj zapisane są wszystkie wiadomości uniemożliwiające poprawną walidację formularza (czyli błędy adnotacji danych oraz wiadomości z instancji <span class="class">@nameof(KAValidationResult)</span> ze statusem <c>@nameof(KAValidationStatus.Error)</c>),
                    </li>
                    <li>
                        <span class="class">@nameof(KAInputBase<>.ValidationResults)</span> dla tego pola - tutaj zapisane są wszystkie instancje <span class="class">@nameof(KAValidationResult)</span> wygenerowane przez niestandardową walidację.
                    </li>
                </ol>
            </div>,
            _ or LocalizationVariant.EN => @<div>
                    <span>After field validation is complete, its results are saved in two places:</span>
                    <ol>
                        <li><span class="class">@nameof(ValidationMessageStore)</span> for this field - this is where all messages preventing correct form validation are saved (i.e., data annotation errors and messages from ValidationResult instances with Error status),</li>
                        <li><span class="class">@nameof(KAInputBase<>.ValidationResults)</span> for this field - this is where all ValidationResult instances generated by custom validation are stored.</li>
                    </ol>
                </div>
            };

            public static string ValidationParamTitle => nameof(KAInputBase<>.Validation);
        public static RenderFragment ValidationParamDescription => CurrentLocalization switch
        {
            LocalizationVariant.PL => @<span>
                Parameter <span class="parameter">@nameof(KAInputBase<>.Validation)</span> pozwala dodać niestandardową logikę walidacji, która (z jakiegokolwiek powodu) nie mogła zostać zawarta w atrybucie walidacji.
                Ten parametr akceptuje instancję <span class="class">@nameof(KAValidation<>)</span>, która akceptuje funkcję walidacji w swoim konstruktorze.
                Klasa <span class="class">@nameof(KAValidationResult)</span> pozwala ustawić wiadomość związaną z wynikiem walidacji oraz jej status.
                Tylko wyniki walidacji ze statusem ustawionym na Error zostaną dodane do wiadomości walidacyjnych dla tego pola (oddziedziczonych po InputBase) i nie pozwolą na pomyślne zwalidowanie całego formularza.
            </span>,
            _ or LocalizationVariant.EN => @<span>
                    Parameter <span class="parameter">@nameof(KAInputBase<>.Validation)</span> allows you to add custom validation logic that (for whatever reason) could not be included in the validation attribute.
                    This parameter accepts a <span class="class">@nameof(KAValidation<>)</span> instance, which accepts a validation function in its constructor.
                    The <span class="class">@nameof(KAValidationResult)</span> class allows you to set a message related to the validation result and its status.
                    Only validation results with a status set to <c>@nameof(KAValidationStatus.Error)</c> will be added to the validation messages for that field (inherited from <span class="class">@nameof(InputBase<>)</span>) and will not allow the entire form to be validated successfully.
                </span>
            };
        public static RenderFragment ValidationParamDemoPremise => CurrentLocalization switch
        {
        LocalizationVariant.PL => @<span>
            W poniższym przykładzie, spróbuj wprowadzić różne liczby całkowite, aby wywołać różne kombinacje wyników walidacji.
        </span>,
        _ or LocalizationVariant.EN => @<span>
                In the example below, try entering different integers to trigger different combinations of validation results.
            </span>
        };
        
        public static string ValidationOutsideFormTitle => CurrentLocalization switch
        {
            LocalizationVariant.PL => "Walidacja poza formularzem",
            _ or LocalizationVariant.EN => "Validation outside form"
        };
        public static RenderFragment ValidationOutsideFormDescription => CurrentLocalization switch
        {
        LocalizationVariant.PL => @<span>
    Możesz użyć parametru <span class="parameter">@nameof(KAInputBase<>.Validation)</span> poza komponentem z kaskadowym <span class="class">@nameof(EditContext)</span>.
            </span>,
            _ or LocalizationVariant.EN => @<span>
                    You can use the <span class="parameter">@nameof(KAInputBase<>.Validation)</span> parameter outside of the component with cascading <span class="class">@nameof(EditContext)</span>.
                </span>
            };

        public static string ValidationBehaviorTitle => nameof(KAInputBase<>.ValidationBehavior);
        public static RenderFragment ValidationBehaviorDescription => CurrentLocalization switch
        {
        LocalizationVariant.PL => @<span>
            Możesz zmienić zachowanie walidacji za pomocą parametru <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span>
            Domyślnie walidacja jest wykonywana za każdym razem, gdy zmienia się wartość (co w większości przypadków jest dodatkowo kontrolowane przez parametr <span class="parameter">@nameof(KAInputBase<>.ValueEvent)</span>).
            Ustawienie <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span> na @nameof(ValidationBehavior.Manual) pozwala użytkownikowi wykonać walidację w wybranym przez siebie momencie.
        </span>,
        _ or LocalizationVariant.EN => @<span>
                You may change the behavior of validation with <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span> parameter.
                By default the validation is performed each time the value changes (which, in most cases, is further controlled by <span class="parameter">@nameof(KAInputBase<>.ValueEvent)</span> parameter).
                Setting the <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span> to @nameof(ValidationBehavior.Manual) allows user to perform the validation at the moment of their choosing.
            </span>
        };
        public static RenderFragment ValidationBehaviorDemoDescription => CurrentLocalization switch
        {
            LocalizationVariant.PL => @<span>W poniższym przykładzie parametr <span class="parameter">@nameof(KAInputBase<>.ValueEvent)</span> każdego pola wejściowego został ustawiony na @nameof(ValueEvent.OnInput), co powinno spowodować sprawdzenie poprawności danych wprowadzonych przez użytkownika w polu. Można to zmienić za pomocą parametru <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span>. </span>,
            _ or LocalizationVariant.EN => @<span>In the following example every input's <span class="parameter">@nameof(KAInputBase<>.ValueEvent)</span> parameter has been set to @nameof(ValueEvent.OnInput) which should result in validation occurring on user inputting anything in the field. This is changed with <span class="parameter">@nameof(KAInputBase<>.ValidationBehavior)</span> parameter. </span>
            };
    };
    }